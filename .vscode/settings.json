{
    "javascript.format.enable": false,
    "eslint.format.enable": true,
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "[javascript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#7e84f6",
        "activityBar.background": "#7e84f6",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#fbc3c6",
        "activityBarBadge.foreground": "#15202b",
        "commandCenter.border": "#e7e7e799",
        "sash.hoverBorder": "#7e84f6",
        "statusBar.background": "#4e56f3",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#7e84f6",
        "statusBarItem.remoteBackground": "#4e56f3",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#4e56f3",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#4e56f399",
        "titleBar.inactiveForeground": "#e7e7e799"
    },
    "peacock.color": "#4e56f3",
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
}